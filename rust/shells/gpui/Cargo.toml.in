[workspace]
resolver = "3"

[package]
name = "t3-desktop-gpui"
version = "0.1.0"
edition = "2024"
publish = false

[dependencies]
t3-ui = { path = "../../crates/t3-ui" }

nsh-platform-gpui = { git = "@NSH_GIT@", rev = "@NSH_REV@", default-features = false }

[profile.dev]
debug = 0

[profile.dev.package."*"]
opt-level = 2
